#!/bin/sh

set -e

for file in "src/quickjs/quickjs-libc.c" "src/quickjs/quickjs.c"
do
  sed -i.bak 's/#pragma GCC diagnostic.*//' "$file"
  sed -i.bak 's/return js_free_cstring(rt, ptr);/js_free_cstring(rt, ptr);/' "$file"
  sed -i.bak 's/return js_free_cstring(ctx->rt, ptr);/js_free_cstring(ctx->rt, ptr);/' "$file"
  rm -f "$file.bak"
done
